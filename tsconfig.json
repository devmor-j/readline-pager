{
  "include": ["./src", "./test", "./scripts/package-native.ts", "./sample.ts"],
  "compilerOptions": {
    "types": ["node", "@types/deno", "@types/bun"],
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
