{
  "name": "readline-pager",
  "version": "0.8.0",
  "scripts": {
    "build:js": "tsdown",
    "build:native": "node-gyp rebuild && node ./scripts/gen-compile-flags.ts",
    "build": "npm run build:native && npm run build:js",
    "test": "./scripts/test.sh",
    "test:coverage": "npx --yes lcov-badge2 coverage/lcov.info -o coverage.svg",
    "prepublishOnly": "npm run test",
    "benchmark": "./scripts/benchmark.sh",
    "prettier": "npx prettier -wu './(src|test)/**/*.{js,cjs,mjs,ts,cts,mts,json,yml,md}'"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "@types/deno": "~2.7.0",
    "@types/node": "~26.0.1",
    "c8": "~11.0.0",
    "lcov-badge2": "~1.1.4",
    "node-gyp": "~13.0.0",
    "prettier": "~3.9.4",
    "prettier-plugin-organize-imports": "~4.3.0",
    "tsdown": "~0.22.3",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "@devmor-j/readline-pager-linux-arm64": "0.8.0",
    "@devmor-j/readline-pager-linux-musl-arm64": "0.8.0",
    "@devmor-j/readline-pager-linux-musl-x64": "0.8.0",
    "@devmor-j/readline-pager-linux-x64": "0.8.0"
  },
  "gypfile": false,
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "exports": {
    ".": {
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs",
      "types": "./dist/main.d.mts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "keywords": [
    "nodejs",
    "readline-pager",
    "file-reader",
    "pagination",
    "large-files",
    "async-iterator",
    "streaming",
    "memory-efficient",
    "high-performance",
    "log-processing",
    "backward-reading",
    "native-addon",
    "cpp",
    "avx2",
    "neon"
  ],
  "description": "High-performance paginated file reader for Node.js. Process large text files efficiently without loading them into memory.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmor-j/readline-pager.git"
  },
  "homepage": "https://github.com/devmor-j/readline-pager#readme",
  "bugs": {
    "url": "https://github.com/devmor-j/readline-pager/issues"
  },
  "engines": {
    "node": ">=18.12"
  },
  "author": "Morteza Jamshidi",
  "license": "MIT"
}
